#include <winver.h>

// The exe's icon; Qt also uses IDI_ICON1 for its windows and the taskbar.
// Drawn from EndfieldVT.png (256 px) at 16-256 px.
IDI_ICON1 ICON "EndfieldVT.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,21,1,0
PRODUCTVERSION  0,21,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "EndfieldVT"
            VALUE "FileDescription",  "EndfieldVT"
            VALUE "FileVersion",      "0.21.1"
            VALUE "InternalName",     "EndfieldVT"
            VALUE "LegalCopyright",   "AGPL-3.0"
            VALUE "OriginalFilename", "EndfieldVT.exe"
            VALUE "ProductName",      "EndfieldVT"
            VALUE "ProductVersion",   "0.21.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
